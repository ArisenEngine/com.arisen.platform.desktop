{
  "id": "com.arisen.platform.desktop",
  "name": "Arisen Desktop Platform",
  "version": "1.0.0",
  "description": "Desktop windowing and message loop provider",
  "author": "Arisen Team",
  "tags": [
    "platform",
    "desktop",
    "windows"
  ],
  "engineVersion": "0.1.0",
  "dependencies": {
    "com.arisen.core.native": "1.0.0",
    "com.arisen.core": "1.0.0"
  },
  "subsystems": [
    {
      "type": "ArisenEngine.Platform.PlatformSubsystem"
    }
  ],
  "services": {
    "provides": [
      {
        "interface": "ArisenKernel.Contracts.IWindowProvider",
        "priority": 100
      }
    ]
  },
  "entry": {
    "assembly": "Com.Arisen.Platform.Desktop.dll",
    "class": "ArisenEngine.Platform.DesktopPackage"
  }
}